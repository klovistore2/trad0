# Trad0 — copy to .env for local use, and set the same names on Vercel.
# Everything stays server side except NEXT_PUBLIC_APP_URL, which is built into the pages.
# Never commit real keys or secrets.

# ── Required ─────────────────────────────────────────────────────────────────

# Exact origin used in the browser (HTTPS on a phone, never localhost in a QR code).
# The origin check, the QR code and the sitemap use it; set it before `npm run build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL.
DATABASE_URL=

# OpenAI: live translation (mode 1), transcription, contextual translation (mode 2), tone.
OPENAI_API_KEY=
# Live translation model (mode 1). Required: the code has no default for it.
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate

# ElevenLabs: speech in mode 2 and consented voice cloning.
ELEVENLABS_API_KEY=

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google sign-in, the only method, required to create a conversation.
# Authorised redirect URI, one per origin: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Protects the daily purge (/api/cleanup). Voice cloning stays off without it.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Optional: the code has a default ─────────────────────────────────────────

# Transcription of what each person says, in both modes. Default: gpt-realtime-whisper.
OPENAI_INPUT_TRANSCRIPTION_MODEL=
# Mode 2 text translation (Chat Completions, structured JSON). Default: gpt-4.1-mini.
OPENAI_TEXT_TRANSLATION_MODEL=
# First detection of the language a person speaks. Default: gpt-4.1-nano.
OPENAI_LANGUAGE_DETECTION_MODEL=

# Standard voices, heard before a speaker has a clone, chosen by their detected vocal range:
# low, high, and neutral when the range is still unknown.
# Left empty, each cold server instance lists the ElevenLabs premade voices at its first
# sentence and takes the first one labelled male, female or neutral. The values below are that
# very choice on 27 September 2026 (Roger, Bella, River: premade, public, American English).
# Setting them skips the lookup and keeps the voice from changing with the order of that list.
# Any voice ID available to the account works, including one from the ElevenLabs Voice Library.
ELEVENLABS_VOICE_LOW=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_VOICE_HIGH=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_FALLBACK_VOICE_ID=SAz9YHcvj6GT2YYXdXww

# JSON RTCIceServer array for the translated audio sent directly between the two phones.
# Configure a TURN service for mobile and NAT-restricted networks, with credentials dedicated
# to it. With [] it only connects where the phones reach each other directly (e.g. same Wi-Fi).
WEBRTC_ICE_SERVERS=[]

# Google account(s) that see the DEV menu, comma-separated; "@domain" covers a whole domain.
# The guest of a conversation created by one of them sees it too. An admin is billed as usual
# but never stopped for lack of credits.
ADMIN_MAIL=

# Credits offered once per account at sign in. Default 300; 0 turns the offer off.
WELCOME_CREDITS=300

# ── Scripts only ─────────────────────────────────────────────────────────────

# `npm run test:tts` (a WebSocket check from Node). Default: eleven_v3_conversational.
# The app never reads it: its speaking model is fixed in code.
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_LOW=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_VOICE_HIGH=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_FALLBACK_VOICE_ID=SAz9YHcvj6GT2YYXdXww