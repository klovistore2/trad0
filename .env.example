# Milestone 1 — server only
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate

# Source-language transcription, so a speaker can check what was recognised.
# Defaults to gpt-realtime-whisper when empty.
OPENAI_INPUT_TRANSCRIPTION_MODEL=

# Initial spoken-language detection from transcript text (defaults to gpt-4.1-nano).
OPENAI_LANGUAGE_DETECTION_MODEL=

# Streaming speech and consented account voice cloning
ELEVENLABS_API_KEY=
# Default only: settings override per outgoing sentence. Thai/emotion use v3.

# Optional standard voices used before a clone exists. Left empty, a premade voice whose
# own label matches the speaker's detected vocal range is chosen automatically.
ELEVENLABS_FALLBACK_VOICE_ID=
ELEVENLABS_VOICE_LOW=
ELEVENLABS_VOICE_HIGH=

# Neon PostgreSQL — server only
DATABASE_URL=

# Required for voice cloning: protects the scheduled deletion endpoint
CRON_SECRET=

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in, the only method. Required to create a conversation.
# Authorised redirect URI, one per origin: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must match the exact origin used in your browser (HTTPS on a phone).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode 2: source transcript -> contextual text translation -> ElevenLabs.
OPENAI_TEXT_TRANSLATION_MODEL=
# Google account(s) that see the DEV panel, comma-separated ("@domain" covers a domain).
# The guest of a conversation created by one of them sees it too. Nobody else does.
ADMIN_MAIL=
# JSON RTCIceServer array. Configure your TURN service for mobile/NAT-restricted networks.
# With [], direct translated audio works only where host candidates can connect (e.g. same LAN).
WEBRTC_ICE_SERVERS=[]

# Credits offered once per account at sign in (default 300; 0 turns the offer off).
WELCOME_CREDITS=300
