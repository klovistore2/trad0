# Milestone 1 — server only
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate

# Source-language transcription, so a speaker can check what was recognised.
# Defaults to gpt-realtime-whisper when empty.
OPENAI_INPUT_TRANSCRIPTION_MODEL=

# Streaming speech and consented session voice cloning
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional standard voices used before a clone exists. Left empty, a premade voice whose
# own label matches the speaker's detected vocal range is chosen automatically.
ELEVENLABS_FALLBACK_VOICE_ID=
ELEVENLABS_VOICE_LOW=
ELEVENLABS_VOICE_HIGH=

# Neon PostgreSQL — server only
DATABASE_URL=

# Required for voice cloning: protects the scheduled deletion endpoint
CRON_SECRET=

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in, the only method. Required to create a conversation.
# Authorised redirect URI, one per origin: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must match the exact origin used in your browser (HTTPS on a phone).
NEXT_PUBLIC_APP_URL=http://localhost:3000
